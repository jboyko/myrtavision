.DS_Store
.venv/
__pycache__/
*.pyc
*.pt
# Frozen LeafMachine heads are ~1 MB; fine-tuned LM2 (~115 MB) and YOLO weights stay in results/ but out of git
!/results/train/lm2_frozen_*/*.pt

# Rebuildable folders; symlinks into /scratch on Great Lakes, so no trailing slash
/data
/datasets
/runs
/weights
/logs

# Raw GBIF exports (scores.csv is derived from them)
/training_data

# Legacy generated datasets and run outputs
legacy/*/data
legacy/*/runs

# Slide-building leftovers
.codex*/
.chart-data-*/
/output

lm2_predictions*.csv
leafmachine_predictions*.csv

# Grad-CAM figures (regenerate with slurm/explain.sbatch)
/results/explain
